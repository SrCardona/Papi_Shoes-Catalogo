node_modules/
dist/
build/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Carpeta de la CLI de Vercel: guarda el id del proyecto y credenciales locales.
.vercel/

# Lotes como llegan del proveedor: zips y carpetas de WhatsApp sin renombrar.
# Las fotos del catalogo si van al repo: viven en public/catalogo/ con su
# nombre definitivo y son las que sirve el sitio.
*.zip
lotes/

# Bandeja de fotos sin clasificar. Entran aqui como las manda el proveedor
# (WhatsApp Image..., IMG_1234) y salen ya renombradas a public/catalogo/
# <linea>/<marca>/. Lo de adentro no se versiona: es material en transito.
public/catalogo/_entrada/*
!public/catalogo/_entrada/.gitkeep
